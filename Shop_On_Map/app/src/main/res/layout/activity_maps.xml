<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MapsActivity">
    <FrameLayout
        android:id="@+id/actvity_maps_map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context="com.wap.googlegps.MapsActivity" />
        <ImageButton
            android:id="@+id/activity_maps_zoom_out_button"
            android:layout_width="38dp"
            android:layout_height="39dp"
            android:padding="5dp"
            android:layout_gravity="right"
            android:layout_marginBottom="80dp"
            android:layout_marginRight="12dp"
            android:layout_marginTop="60dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/rounded_rectangle_shape"
            android:src="@drawable/ic_zoom_out_map"/>
    </FrameLayout>

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/activity_maps_appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:background="#74EEDACA"
        android:fitsSystemWindows="true"
        android:theme="@style/AppTheme.AppBarOverlay">
        <!--android:minHeight="?attr/actionBarSize"-->
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="510dp"
            android:fitsSystemWindows="true"
            android:nestedScrollingEnabled="true"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <RelativeLayout
                android:id="@+id/activity_maps_slideshow_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                app:layout_collapseMode="pin">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <include layout="@layout/shimmer_layout" />

                </com.facebook.shimmer.ShimmerFrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/actvity_maps_recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:paddingTop="10dp" />

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:layout_below="@id/actvity_maps_recyclerview"
                    android:layout_marginTop="5dp"
                    android:background="#963f51b5"
                    app:layout_collapseMode="pin"
                    app:popupTheme="@style/AppTheme.PopupOverlay" />
            </RelativeLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginRight="32dp"
        android:src="@drawable/ic_floating_action_bar"
        android:tint="@android:color/white"
        android:visibility="gone"
        app:layout_anchor="@id/activity_maps_appBarLayout"
        app:layout_anchorGravity="bottom|right|end" />

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/activity_maps_bottom_navigation_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:menu="@menu/bottom_navigation_menu" />
    </RelativeLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/activity_maps_add_post_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="100dp"
        android:src="@drawable/ic_add"
        app:fabSize="normal"
        app:layout_anchor="@id/map"
        app:layout_anchorGravity="right|end|bottom" />
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/activity_maps_cancel_search_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="100dp"
        android:src="@drawable/ic_arrow_back"
        android:backgroundTint="@color/colorGray"
        app:fabSize="normal"
        app:layout_anchor="@id/map"
        app:layout_anchorGravity="right|end|bottom"
        android:visibility="gone"/>




</androidx.coordinatorlayout.widget.CoordinatorLayout>
