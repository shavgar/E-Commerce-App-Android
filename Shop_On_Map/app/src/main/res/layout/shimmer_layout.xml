<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:background="#FAF7F7"
    app:cardCornerRadius="15dp"
    app:cardElevation="5dp">

    <LinearLayout
        android:id="@+id/item_placeholder_parent_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:id="@+id/item_placeholder_image"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@color/item_placeholder"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_below="@id/item_placeholder_image"
            android:orientation="horizontal"
            android:padding="10dp">

            <View
                android:id="@+id/item_placeholder_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/item_placeholder" />

            <View
                android:id="@+id/item_placeholder_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:background="@color/item_placeholder" />

            <ImageView
                android:id="@+id/item_placeholder_edit_button"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/ic_circle_gray"
                android:src="@drawable/ic_edit"
                android:visibility="gone"/>

        </LinearLayout>

        <View
            android:id="@+id/item_placeholder_description"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:paddingLeft="15dp"
            android:paddingTop="10dp"
            android:background="@color/item_placeholder" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_gravity="bottom">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/item_placeholder_user_image"
                android:layout_width="40dp"
                android:layout_height="50dp"
                android:layout_alignParentBottom="true"
                android:layout_centerVertical="true"
                android:paddingLeft="5dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:src="@color/item_placeholder" />

            <View
                android:id="@+id/item_placeholder_username"
                android:layout_width="80dp"
                android:layout_height="30dp"
                android:layout_alignParentBottom="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="5dp"
                android:layout_marginBottom="10dp"
                android:layout_toRightOf="@+id/item_placeholder_user_image"
                android:background="@color/item_placeholder" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/item_placeholder_phone_button"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_centerInParent="true"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:layout_alignParentRight="true"
                android:src="@color/item_placeholder"/>

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/item_placeholder_chat_button"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_centerInParent="true"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:layout_toLeftOf="@id/item_placeholder_phone_button"
                android:src="@color/item_placeholder" />

        </RelativeLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
