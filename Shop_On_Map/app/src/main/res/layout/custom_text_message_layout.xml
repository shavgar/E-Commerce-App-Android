<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/custom_text_message_layout_reciever_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="5dp"
        android:background="@drawable/ic_circle_gray"
        android:gravity="center"
        android:minHeight="30dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:text="Reciever Message"
        android:textColor="@color/lineColor"
        android:textSize="18dp" />

    <TextView
        android:id="@+id/custom_text_message_layout_sender_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:background="@drawable/ic_circle_lightgreen"
        android:gravity="center"
        android:minHeight="30dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:text="Sender Message"
        android:textColor="@color/lineColor"
        android:textSize="18dp" />

</RelativeLayout>