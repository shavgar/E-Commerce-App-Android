<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ChatActivity">

    <include
        android:id="@+id/activity_chat_toolbar"
        layout="@layout/toolbar_layout" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/activity_chat_send_messages_relativelayout"
        android:layout_below="@id/activity_chat_toolbar">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/activity_chat_messages_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:stackFromEnd="true"/>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/activity_chat_send_messages_relativelayout"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:background="@android:color/background_light"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingLeft="10dp"
        android:paddingRight="8dp">

        <EditText
            android:id="@+id/activity_chat_send_message_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@id/actvity_chat_send_picture_button"
            android:background="@drawable/ic_circle_lightgray"
            android:layout_marginRight="5dp"
            android:paddingLeft="10dp"
            android:ems="10"
            android:minHeight="40dp" />

        <ImageButton
            android:id="@+id/actvity_chat_send_message_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentRight="true"
            android:background="@drawable/ic_circle_lightgreen"
            android:padding="5dp"
            android:src="@drawable/ic_send_message" />

        <ImageButton
            android:id="@+id/actvity_chat_send_picture_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="10dp"
            android:layout_toLeftOf="@id/actvity_chat_send_message_button"
            android:background="@drawable/ic_circle_lightgreen"
            android:padding="5dp"
            android:src="@drawable/ic_camera" />

    </RelativeLayout>
</RelativeLayout>