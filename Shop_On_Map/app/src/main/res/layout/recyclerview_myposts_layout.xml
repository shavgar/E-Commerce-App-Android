<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:background="#FAF7F7"
    app:cardCornerRadius="15dp"
    app:cardElevation="5dp">

    <LinearLayout
        android:id="@+id/myposts_post_parent_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/view_boarder_lightgray"

        android:orientation="vertical">

        <ImageView
            android:id="@+id/myposts_post_image"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:src="@drawable/add_new_post" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:id="@+id/myposts_post_type"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_gravity="center_vertical"
                android:layout_weight="2"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingLeft="8dp"
                android:text="Title"
                android:textColor="#C61A677E"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/myposts_post_price"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:gravity="right|center_vertical"
                android:paddingRight="10dp"
                android:text="Price"
                android:textColor="#58DD05"
                android:textSize="17sp" />
        </LinearLayout>

        <View
            style="@style/viewsDevider"
            android:layout_height="1dp"
            android:layout_marginBottom="5dp" />

        <TextView
            android:id="@+id/myposts_post_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:background="@color/white2"
            android:paddingLeft="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="Description"
            android:textColor="@color/lineColor"
            android:textSize="15sp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="bottom">

            <View
                style="@style/viewsDevider"
                android:layout_height="1dp"
                android:layout_marginTop="5dp" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/myposts_post_date_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="10dp"
                android:background="@drawable/ic_circle_gray"
                android:padding="3dp"
                android:src="@drawable/ic_date" />

            <TextView
                android:id="@+id/myposts_post_date"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="5dp"
                android:layout_toRightOf="@+id/myposts_post_date_icon"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="psot date"
                android:textColor="@color/lineColor"
                android:textSize="15sp" />

        </RelativeLayout>

        <View
            style="@style/viewsDevider"
            android:layout_height="15dp"
            android:layout_gravity="bottom"
            android:layout_marginTop="5dp" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
