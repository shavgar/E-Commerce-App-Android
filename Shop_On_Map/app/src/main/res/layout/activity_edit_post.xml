<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_edit_post_parent_ralativelayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_circle_white"
    android:orientation="vertical">

    <include
        android:id="@+id/activity_edit_post_toolbar"
        layout="@layout/toolbar_layout" />

    <ScrollView
        android:id="@+id/activity_edit_post_main_content_scrollview_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/activity_edit_post_toolbar"
        android:paddingLeft="10dp"
        android:paddingTop="5dp"
        android:paddingRight="10dp">

        <LinearLayout
            android:id="@+id/activity_edit_post_Linearlayout1"
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:background="@drawable/ic_circle_white"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:id="@+id/activity_edit_post_product_image"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:background="@color/white"
                android:scaleType="centerCrop"
                android:src="@drawable/add_new_post" />

            <View
                style="@style/viewsDevider"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/activity_edit_post_type"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_below="@id/activity_edit_post_product_image"
                    android:layout_weight="2"
                    android:background="@drawable/ic_circle_lightgray"
                    android:gravity="center_vertical"
                    android:paddingLeft="10dp"
                    android:hint="Type"
                    android:inputType="textCapWords"
                    android:maxLength="80"
                    android:maxLines="1"
                    android:textColor="@color/lineColor"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/activity_edit_post_price"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="1"
                    android:background="@drawable/ic_circle_lightgray"
                    android:gravity="right|center_vertical"
                    android:layout_marginLeft="5dp"
                    android:hint="$ Price"
                    android:inputType="number"
                    android:maxLength="20"
                    android:maxLines="1"
                    android:paddingRight="10dp"
                    android:textColor="#58DD05"
                    android:textSize="17sp" />
            </LinearLayout>

            <View
                style="@style/viewsDevider"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"/>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/ic_circle_lightgray">

                <EditText
                    android:id="@+id/activity_edit_post_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@android:color/transparent"
                    android:hint="Description"
                    android:inputType="textCapSentences|textNoSuggestions|textMultiLine"
                    android:textSize="15sp"
                    android:paddingLeft="10dp"/>
            </ScrollView>

            <View
                style="@style/viewsDevider"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"/>


            <RelativeLayout
                android:id="@+id/activity_edit_post_bottom_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:paddingTop="5dp">

                <TextView
                    android:id="@+id/activity_edit_post_publish_date"
                    android:layout_width="90dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="15dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="mm/dd/yyyy"
                    android:textColor="@color/lineColor"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/activity_edit_update_post_button"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="5dp"
                    android:background="@drawable/ic_circle_green"
                    android:clickable="true"
                    android:drawablePadding="5dp"
                    android:fontFamily="sans-serif-black"
                    android:padding="5dp"
                    android:text="Update"
                    android:textColor="@color/white" />
            </RelativeLayout>

        </LinearLayout>

    </ScrollView>

    <ProgressBar
        android:id="@+id/activity_edit_post_progressbar"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_centerInParent="true"
        android:visibility="gone" />

</RelativeLayout>
