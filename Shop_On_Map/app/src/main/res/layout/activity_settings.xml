<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_circle_white"
    android:orientation="vertical"
    tools:context=".ui.Settings">

    <include
        android:id="@+id/activity_settings_toolbar"
        layout="@layout/toolbar_layout" />

    <RelativeLayout
        android:layout_width="380dp"
        android:layout_height="250dp"
        android:layout_gravity="center">


        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/activity_settings_profile_image"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_centerInParent="true"
            android:background="@drawable/ic_circle_white"
            android:src="@drawable/profile_image" />

        <ProgressBar
            android:id="@+id/activity_settings_progressbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:visibility="gone" />
    </RelativeLayout>

    <ScrollView
        android:id="@+id/activity_settings_scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <LinearLayout
            android:layout_width="360dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_margin="5dp"
            android:background="@drawable/ic_circle_white"
            android:orientation="vertical">

            <EditText
                android:id="@+id/activity_settings_first_name"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="5dp"
                android:background="@android:color/transparent"
                android:drawableLeft="@drawable/ic_name"
                android:drawablePadding="12dp"
                android:hint="First Name"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:padding="10dp"
                android:paddingLeft="12dp"
                android:textColor="@color/lineColor"
                android:textColorHint="@color/lightOrange"
                android:textSize="20sp" />

            <View
                style="@style/viewsDevider"
                android:layout_height="1dp"
                android:background="@color/lightOrange" />

            <EditText
                android:id="@+id/activity_settings_last_name"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="5dp"
                android:background="@android:color/transparent"
                android:drawableLeft="@drawable/ic_name"
                android:drawablePadding="12dp"
                android:hint="Last Name"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:padding="10dp"
                android:textColor="@color/lineColor"
                android:textColorHint="@color/lightOrange"
                android:textSize="20sp" />

            <View
                style="@style/viewsDevider"
                android:layout_height="1dp"
                android:background="@color/lightOrange" />

            <EditText
                android:id="@+id/activity_settings_country"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="5dp"
                android:background="@android:color/transparent"
                android:drawableLeft="@drawable/ic_country"
                android:drawablePadding="12dp"
                android:hint="Country"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:padding="10dp"
                android:textColor="@color/lineColor"
                android:textColorHint="@color/lightOrange"
                android:textSize="20sp" />

            <View
                style="@style/viewsDevider"
                android:layout_height="1dp"
                android:background="@color/lightOrange" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:paddingLeft="12dp"
                    android:paddingRight="3sp"
                    android:src="@drawable/ic_phone_orange" />

                <com.hbb20.CountryCodePicker
                    android:id="@+id/activity_settings_country_code"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom"
                    android:gravity="center"
                    app:ccp_defaultPhoneCode="964"
                    app:ccp_showFlag="false"
                    app:ccp_showNameCode="false"
                    app:ccp_textSize="20sp" />

                <EditText
                    android:id="@+id/activity_settings_phone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_weight="2"
                    android:background="@android:color/transparent"
                    android:hint="Phone"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:padding="8dp"
                    android:text="7824853858"
                    android:textColor="@color/lineColor"
                    android:textColorHint="@color/lightOrange"
                    android:textSize="20sp" />
            </LinearLayout>

            <View
                style="@style/viewsDevider"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:background="@color/lightgray" />

            <EditText
                android:id="@+id/activity_settings_email"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:drawableLeft="@drawable/ic_email_orange"
                android:drawablePadding="12dp"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:padding="8dp"
                android:textColor="@color/lineColor"
                android:textColorHint="@color/lightOrange"
                android:textSize="20sp" />

            <View
                style="@style/viewsDevider"
                android:layout_height="1dp"
                android:background="@color/lightOrange" />

            <TextView
                android:id="@+id/activity_settings_password"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@android:color/transparent"
                android:drawableLeft="@drawable/ic_lock_orange"
                android:drawableRight="@drawable/ic_right_arrow"
                android:drawablePadding="12dp"
                android:gravity="left|center_vertical"
                android:padding="8dp"
                android:text="Password"
                android:textColor="@color/lineColor"
                android:textSize="20sp" />

            <View
                style="@style/viewsDevider"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:background="@color/lightgray" />


            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/activity_settings_switch_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@android:color/transparent"
                android:checked="false"
                android:drawableLeft="@drawable/ic_notifications_orange"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:text="Notifications"
                android:textOff="OFF"
                android:textOn="ON"
                android:textSize="20dp" />

            <View
                style="@style/viewsDevider"
                android:layout_height="20dp"
                android:background="@color/lightgray" />

            <Button
                android:id="@+id/activity_settings_save_button"
                style="@style/Base.TextAppearance.AppCompat.Body1"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="25dp"
                android:background="@drawable/ic_circle_orange"
                android:clickable="true"
                android:fontFamily="sans-serif-black"
                android:padding="16dp"
                android:text="Save "
                android:textAllCaps="false"
                android:textColor="#EEEEEB"
                android:textSize="20sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

